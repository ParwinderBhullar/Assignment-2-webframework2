    {
      "name": "02 • STUDENT LOGIN / FAVOURITES / PREFERENCE",
      "description": "Log in as the seeded regular student. Retain the cookie automatically in Postman. These requests create, read, patch and validate a favourite, save a dark theme, and verify that students receive 403 on admin routes.",
      "item": [
        {
          "name": "02.01 - Student login: 200 + HttpOnly cookie",
          "id": "81ae8cfc-ed48-5604-81bc-d24cae792c65",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Required screenshot: HTTP 200 and user object. Show the Headers tab / Set-Cookie attribute but MASK the full cookie value and any password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Student response has safe role/user fields\", function () {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.user).to.be.an(\"object\");",
                  "  pm.expect(d.user.role).to.eql(\"user\");",
                  "  pm.expect(d.user.email).to.eql(pm.variables.get(\"studentEmail\"));",
                  "  pm.expect(d.user).not.to.have.property(\"passwordHash\");",
                  "});",
                  "pm.test(\"Set-Cookie is HttpOnly session\", function () {",
                  "  const h = pm.response.headers.get(\"Set-Cookie\") || \"\";",
                  "  pm.expect(h).to.include(\"a2_session=\");",
                  "  pm.expect(h.toLowerCase()).to.include(\"httponly\");",
                  "});"
                ]
              }
            }
          ]
        },

  "info": {
    "_postman_id": "2aaab778-e3d7-5ef5-b3fe-55a459c3a3f7",
    "name": "ITE5425 Assignment 2 — Art Explorer COMPLETE API Tests (Run in Order)",
    "description": "Complete, sequential Postman test suite based on the actual Next.js Route Handlers in ArtExplorer_Assignment2.zip. Covers Atlas health, guest 401, bad password 401, student JWT cookie and role 403, favourites POST/GET/PATCH/DELETE, validation, saved theme, admin role 200, session persistence after logout, and cleanup.\n\nIMPORTANT: Start npm run dev and seed Atlas first. Collection test passwords are the INSTRUCTOR'S DISPOSABLE DEMO CREDENTIALS from scripts/seed-users.mjs, not your Atlas database password. Keep cookie jar enabled. Do NOT submit this collection to public Git or record credentials, JWTs, secrets or cookie values in screenshots. The tests are unexecuted until you run them locally. No public registration endpoint exists.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 • START / GUEST (run first)",
      "description": "Start with npm run dev, a successful MongoDB Atlas seed, and a working /api/health. Run in the listed order. The first logout clears any prior Postman cookie. Postman must keep its cookie jar enabled.",
      "item": [
        {
          "name": "01.01 - Start clean: logout previous Postman session",
          "id": "9246ec96-79c9-5c8d-afd3-fa990a7bace6",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Reset the Postman cookie jar before guest authorization tests; 200 with a session-clearing cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Logout response\", function () { pm.expect(pm.response.json().message).to.eql(\"Logged out\"); });"
                ]
              }
            }
          ]
        },
